                {
                    "name": "FB_APP_SECRET",
                    "valueFrom": "arn:aws:ssm:ap-south-1:400115659362:parameter/ECS-erp-backend-dev/FB_APP_SECRET"
                },
                {
                    "name": "FB_VERIFY_TOKEN",
                    "valueFrom": "arn:aws:ssm:ap-south-1:400115659362:parameter/ECS-erp-backend-dev/FB_VERIFY_TOKEN"
                },
                {
                    "name": "FB_BUSINESS_ID",
                    "valueFrom": "arn:aws:ssm:ap-south-1:400115659362:parameter/ECS-erp-backend-dev/FB_BUSINESS_ID"
                },
                {
                    "name": "FB_SYSTEM_USER_TOKEN",
                    "valueFrom": "arn:aws:ssm:ap-south-1:400115659362:parameter/ECS-erp-backend-dev/FB_SYSTEM_USER_TOKEN"
