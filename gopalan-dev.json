{
  "family": "gopalan-dev",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::400115659362:role/ecsExecutionRole-gopalan-dev",
  "containerDefinitions": [
    {
      "name": "gopalan",
      "image": "400115659362.dkr.ecr.ap-south-1.amazonaws.com/gopalan-dev:latest",
      "cpu": 0,
      "essential": true,
      "portMappings": [
        {
          "name": "gopalan-dev-8000-tcp",
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "secrets": [
        {
          "name": "GEMINI_API_KEY",
          "valueFrom": "arn:aws:ssm:ap-south-1:400115659362:parameter/ECS-gopalan-dev/GEMINI_API_KEY"
        },
        {
          "name": "DB_DIALECT",
          "valueFrom": "arn:aws:ssm:ap-south-1:400115659362:parameter/ECS-gopalan-dev/DB_DIALECT"
        },
        {
          "name": "DB_HOST",
          "valueFrom": "arn:aws:ssm:ap-south-1:400115659362:parameter/ECS-gopalan-dev/DB_HOST"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:ssm:ap-south-1:400115659362:parameter/ECS-gopalan-dev/DB_PASSWORD"
        },
        {
          "name": "DB_USER",
          "valueFrom": "arn:aws:ssm:ap-south-1:400115659362:parameter/ECS-gopalan-dev/DB_USER"
        },
        {
          "name": "DB_NAME",
          "valueFrom": "arn:aws:ssm:ap-south-1:400115659362:parameter/ECS-gopalan-dev/DB_NAME"
        },
        {
          "name": "DB_PORT",
          "valueFrom": "arn:aws:ssm:ap-south-1:400115659362:parameter/ECS-gopalan-dev/DB_PORT"
        },
        {
          "name": "DB_SUPPORTS_SCHEMA",
          "valueFrom": "arn:aws:ssm:ap-south-1:400115659362:parameter/ECS-gopalan-dev/DB_SUPPORTS_SCHEMA"
        },
        {
          "name": "DB_DRIVER",
          "valueFrom": "arn:aws:ssm:ap-south-1:400115659362:parameter/ECS-gopalan-dev/DB_DRIVER"
        },
        {
          "name": "SERVICE_NAME",
          "valueFrom": "arn:aws:ssm:ap-south-1:400115659362:parameter/ECS-gopalan-dev/SERVICE_NAME"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/gopalan-dev",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
