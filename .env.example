# PostgreSQL connection string used by database.py
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# YouTube Data API v3 key, used by collector.py for channel/comment scraping
YOUTUBE_API_KEY=

# Groq API key (OpenAI-compatible), used for AI sentiment/label classification
GROQ_API_KEY=

# Comma-separated list of Google Play package names to monitor for reviews
PLAYSTORE_PACKAGE_NAMES=com.example.app1,com.example.app2

# Meta (Facebook/Instagram) long-lived user access token with pages/IG permissions
META_USER_TOKEN=

# Meta Business Manager ID, used to build the "reply in inbox" links
META_BUSINESS_ID=

# Token you choose yourself; must match the value entered in the Meta webhook setup
WEBHOOK_VERIFY_TOKEN=

# Comma-separated brand/product keywords to search for on YouTube and News
TARGET_KEYWORDS=Your Brand Name,Another Keyword

# Comma-separated YouTube channel IDs to pull historical comments from
TARGET_CHANNEL_IDS=UCxxxxxxxxxxxxxxxxxxxxxx

# Password required to log into the dashboard
DASHBOARD_PASSWORD=

# Random secret used to sign login tokens (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
JWT_SECRET=

# Google Business Profile account ID (the numeric ID from "accounts/{id}"), used by
# google_maps_service.py to fetch/reply to Google Maps reviews and create new
# store listings (via the "Add a new store listing" form on the dashboard, or
# POST /api/google-maps/stores). Requires either a one-time interactive login
# (creates business_token.pickle) or GOOGLE_MAPS_REFRESH_TOKEN below - see
# google_maps_service.py's module docstring.
GOOGLE_BUSINESS_ACCOUNT_ID=

# Optional - only needed for a headless setup where no one can run an
# interactive browser login on the machine this backend runs on. A refresh
# token generated manually (e.g. via Google's OAuth 2.0 Playground) for the
# Business Profile ("business.manage") scope. Requires maps_client_secrets.json
# (the OAuth client's downloaded credentials file, renamed) to also be present.
GOOGLE_MAPS_REFRESH_TOKEN=
